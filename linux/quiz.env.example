# Copy to linux/quiz.env and fill in. quiz.env is ignored by git, so the key never lands in the repo.

# live = real TikTok chat and stream | practice = fake chat, still streams | preview = fake chat, records saved/preview.mp4 for 60s
MODE=preview

# TikTok account whose LIVE chat the quiz reads
TIKTOK_USERNAME=hoopshype

# From TikTok's LIVE creator tools ("Server URL" and "Stream key"). Some accounts get a new key each LIVE.
RTMP_URL=
STREAM_KEY=

# Picture: the quiz is drawn at 1080x1920. 720x1280 roughly halves the CPU the encoder needs.
STREAM_SIZE=1080x1920
STREAM_FPS=30
VIDEO_KBPS=4500
